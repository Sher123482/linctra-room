  "npcs": [
    {
      "id": "npc-greeter",
      "name": { "family": "櫃檯", "given": "接待" },
      "actorKey": "jk-girl",
      "packId": "basepack",
      "x": 12,
      "y": 9,
      "facing": "down",
      "enabled": true,
      "collisionMode": "soft",
      "behavior": {
